# Database
MONGO_URI=

# Global email behavior
# EMAIL_PROVIDER supported:
# smtp | mailchimp | mailchimp_marketing | mailchimp_transactional | mailchimp_txn | mandrill
EMAIL_PROVIDER=mailchimp
EMAIL_DELIVERY_DISABLED=false

# Shared sender metadata
EMAIL_FROM=Lisbon Whisper <info@lisbonwhisper.com>
REPLY_EMAIL=info@lisbonwhisper.com
CONTACT_EMAIL=info@lisbonwhisper.com
WEBSITE_URL=https://www.lisbonwhisper.com

# Subjects / admin targets
BOOKING_EMAIL_SUBJECT=Lisbon Whisper booking confirmation
BOOKING_ADMIN_SUBJECT=New booking received
CONTACT_ADMIN_SUBJECT=New contact form submission
ADMIN_NOTICE_EMAIL=info@lisbonwhisper.com

# Generic SMTP provider (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Mailchimp Marketing API (when EMAIL_PROVIDER=mailchimp or mailchimp_marketing)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us20
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_FROM_NAME=Lisbon Whisper
MAILCHIMP_FROM_EMAIL=info@lisbonwhisper.com
MAILCHIMP_REPLY_TO=info@lisbonwhisper.com
# Required only if your audience has ADDRESS merge field required
MAILCHIMP_DEFAULT_ADDRESS_ADDR1=
MAILCHIMP_DEFAULT_ADDRESS_ADDR2=
MAILCHIMP_DEFAULT_ADDRESS_CITY=
MAILCHIMP_DEFAULT_ADDRESS_STATE=
MAILCHIMP_DEFAULT_ADDRESS_ZIP=
MAILCHIMP_DEFAULT_ADDRESS_COUNTRY=PT
# Alternative single JSON form:
# MAILCHIMP_DEFAULT_ADDRESS_JSON={"addr1":"Rua ...","city":"Lisbon","state":"Lisbon","zip":"1000-001","country":"PT"}

# Mailchimp Transactional (Mandrill) API (when EMAIL_PROVIDER=mailchimp_transactional/mailchimp_txn/mandrill)
MAILCHIMP_TXN_API_KEY=
MAILCHIMP_TRANSACTIONAL_API_KEY=
MANDRILL_API_KEY=
